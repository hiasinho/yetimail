#!/usr/bin/env bash
# Offline production-service tests. Only temporary fixture logs; no real opens.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/tests/integration/harness.sh"
integration_init attachments
ln -s "$root/MailService.qml" "$work/MailService.qml"
ln -s "$root/AccountSettingsService.qml" "$work/AccountSettingsService.qml"
cp "$root/tests/integration/attachments/python-fixture" "$work/bin/python3"
cp "$root/tests/integration/attachments/xdg-open" "$work/bin/xdg-open"
cp "$root/tests/integration/attachments/shell.qml" "$work/shell.qml"
export YETIMAIL_OPEN_ARGS="$work/open-args"
export YETIMAIL_OPENER_PIDS="$YETIMAIL_CHILD_PIDS"
export YETIMAIL_OPENER_FINISHED="$work/opener-finished"
: > "$YETIMAIL_OPEN_ARGS"
: > "$YETIMAIL_OPENER_FINISHED"

integration_run_qml attachments 60
integration_assert_output attachments YETIMAIL_ATTACHMENTS_OK \
    'ATTACHMENTS_FAIL|ReferenceError|TypeError|SyntaxError'
integration_assert_no_himalaya
printf '1\n/tmp/attachment with spaces.txt\n1\n/tmp/linger.txt\n1\n/tmp/linger.txt\n1\n/tmp/linger.txt\n' > "$work/expected-open-args"
cmp "$work/expected-open-args" "$YETIMAIL_OPEN_ARGS"
printf 'finished\nfinished\n' > "$work/expected-finished"
cmp "$work/expected-finished" "$YETIMAIL_OPENER_FINISHED"
