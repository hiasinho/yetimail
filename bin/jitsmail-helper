#!/usr/bin/env python3
"""One-shot Himalaya 2.1 adapter. Only stdout is the JSON protocol."""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import uuid
from email import policy
from email.parser import BytesParser
from html.parser import HTMLParser
from urllib.parse import urlsplit
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from attachments import AttachmentError, metadata as attachment_metadata, save as save_attachment
from mailbox_config import MailboxConfigError, check_literal_mailbox, config_paths, merge, tomllib
from message_cache import CacheKey, MessageCache


TIMEOUT = 30
PAGE_SIZE = 50
MESSAGE_PARSER_VERSION = "1"


class HelperError(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise HelperError(message)


class MessageLinks:
    """Collect inert HTTP(S) destinations in first-display order."""

    pattern = re.compile(r"https?://[^\s<>\"'\x00-\x1f\x7f]+", re.IGNORECASE)

    def __init__(self):
        self.links = []
        self.numbers = {}

    def add(self, url, label=""):
        url = url.strip()
        if any(character.isspace() or ord(character) < 32 or ord(character) == 127
               for character in url) or "\\" in url:
            return None
        try:
            parsed = urlsplit(url)
            if (parsed.scheme.lower() not in {"http", "https"} or not parsed.hostname
                    or parsed.username is not None or parsed.password is not None):
                return None
            parsed.port  # Reject malformed ports, including out-of-range values.
        except ValueError:
            return None
        if url not in self.numbers:
            label = " ".join(label.split())
            if not label or self.pattern.fullmatch(label):
                label = parsed.hostname
            self.links.append({"label": label[:160], "url": url})
            self.numbers[url] = len(self.links)
        return f"[{self.numbers[url]}]"

    def text(self, text):
        def replace(match):
            original = match.group()
            url = original
            # Explicit angle brackets or quotes delimit the exact destination.
            opening = text[match.start() - 1:match.start()] if match.start() else ""
            closing = text[match.end():match.end() + 1]
            delimited = opening in {"<", '"', "'"} and closing == {
                "<": ">", '"': '"', "'": "'",
            }.get(opening)
            # Only undelimited prose needs punctuation heuristics.
            while url and not delimited:
                if url[-1] in ".,;:!?":
                    url = url[:-1]
                elif url[-1] in ")]}":
                    closing = url[-1]
                    opening = {")": "(", "]": "[", "}": "{"}[closing]
                    if url.count(closing) <= url.count(opening):
                        break
                    url = url[:-1]
                else:
                    break
            reference = self.add(url)
            return reference + original[len(url):] if reference else original
        return self.pattern.sub(replace, text)


class HTMLText(HTMLParser):
    """Extract inert text; never render markup or load external resources."""

    hidden = {"script", "style", "head", "iframe", "object", "template"}
    paragraphs = {"p", "h1", "h2", "h3", "h4", "h5", "h6", "blockquote"}
    blocks = {"div", "hr", "li", "tr"}

    void = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link",
            "meta", "param", "source", "track", "wbr"}

    def __init__(self, links):
        super().__init__(convert_charrefs=True)
        self.links = links
        self.parts = []
        self.pending = []
        self.suppressed = []
        self.anchor = None
        self.breaks = 0

    def boundary(self, count=1, explicit=False):
        # Block edges coalesce; explicit <br>s add lines (including empty ones).
        if self.anchor is not None:
            # Anchor labels remain compact prose, with whitespace between blocks.
            self.anchor[1].append("\n" * count)
        else:
            self.breaks = min(2, self.breaks + count) if explicit else max(self.breaks, count)

    def with_breaks(self, text):
        if not self.breaks:
            return text
        if not text.strip():
            return ""
        text = "\n" * self.breaks + text.lstrip()
        self.breaks = 0
        return text

    def append(self, text):
        if self.anchor is not None:
            self.anchor[1].append(text)
        else:
            self.pending.append(self.with_breaks(text))

    def flush_text(self):
        # Inline markup can split a URL across arbitrarily many text nodes.
        self.parts.append(self.links.text("".join(self.pending)))
        self.pending.clear()

    def finish_anchor(self):
        if self.anchor is None:
            return
        url, parts = self.anchor
        self.anchor = None
        label = " ".join("".join(parts).split())
        reference = self.links.add(url, label)
        if reference:
            # URL-shaped labels are not useful prose and can be enormous.
            text = (self.links.text(label) + " "
                    if label and not self.links.pattern.fullmatch(label)
                    else "") + reference
        else:
            text = self.links.text(label)
        self.parts.append(self.with_breaks(text))

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        style = re.sub(r"\s+", "", attrs.get("style") or "").lower()
        hidden = (tag in self.hidden or "hidden" in attrs
                  or (attrs.get("aria-hidden") or "").lower() == "true"
                  or re.search(r"(?:^|;)(?:display:none|visibility:hidden)(?:!important)?(?:;|$)", style))
        if self.suppressed or hidden:
            if tag not in self.void:
                self.suppressed.append(tag)
            return
        if tag == "a":
            self.finish_anchor()
            self.flush_text()
            self.anchor = (attrs.get("href") or "", [])
        if tag == "br":
            self.boundary(explicit=True)
        elif tag in self.paragraphs:
            self.boundary(2)
        elif tag in self.blocks:
            self.boundary()

    def handle_endtag(self, tag):
        if self.suppressed:
            if tag in self.suppressed:
                index = len(self.suppressed) - 1 - self.suppressed[::-1].index(tag)
                del self.suppressed[index:]
            return
        if tag == "a":
            self.finish_anchor()
        if tag in self.paragraphs:
            self.boundary(2)
        elif tag in self.blocks:
            self.boundary()

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        self.handle_endtag(tag)

    def handle_data(self, data):
        if not self.suppressed:
            # Source formatting is HTML whitespace, not a displayed line break.
            self.append(re.sub(r"[ \t\r\n\f]+", " ", data))

    def text(self):
        self.finish_anchor()
        self.flush_text()
        text = "\n".join(" ".join(line.split()) for line in "".join(self.parts).split("\n"))
        return re.sub(r"\n{3,}", "\n\n", text).strip()


def run_himalaya(args, command):
    argv = ["himalaya"]
    if args.config is not None:
        argv.append("--config=" + args.config)
    if args.account is not None:
        argv.append("--account=" + args.account)
    try:
        result = subprocess.run(
            argv + command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=TIMEOUT, check=False,
        )
    except FileNotFoundError:
        raise HelperError("Himalaya is not installed or not on PATH") from None
    except subprocess.TimeoutExpired:
        raise HelperError("Himalaya timed out after 30 seconds") from None
    except OSError:
        raise HelperError("Could not start Himalaya") from None
    if result.returncode:
        # Do not echo backend diagnostics: they can contain private config details.
        raise HelperError(f"Himalaya failed (exit {result.returncode})")
    return result.stdout


def mailbox_args(args):
    # IDs are mailbox-scoped. Empty/omitted preserves the configured inbox alias.
    return ["--mailbox=" + args.mailbox] if args.mailbox else []


def cache_context(args):
    """Hash effective config/account inputs without retaining credentials."""
    try:
        if tomllib is None:
            return None
        digest = hashlib.sha256()
        config = {}
        for path in config_paths(args.config):
            digest.update(b"\0path\0" + os.fsencode(path))
            with path.open("rb") as source:
                raw = source.read()
            digest.update(raw)
            config = merge(config, tomllib.loads(raw.decode("utf-8")))
        accounts = config["accounts"]
        requested = args.account
        if requested in (None, "", "default"):
            names = [name for name, value in accounts.items()
                     if isinstance(value, dict) and value.get("default") is True]
            if len(names) != 1:
                return None
            requested = names[0]
        if requested not in accounts:
            return None
        digest.update(b"\0account\0" + requested.encode("utf-8"))
        return digest.hexdigest()
    except (OSError, UnicodeError, ValueError, KeyError, TypeError, RecursionError):
        return None


def message_cache(args, require_identity=True):
    # Persistent hits require identity from a current envelope listing. Direct
    # helper reads without it deliberately fetch from Himalaya every time.
    if ((require_identity and not getattr(args, "cache_identity", None))
            or os.environ.get("JITSMAIL_CACHE", "1").lower() in {"0", "false", "no", "off"}):
        return None, None
    context = cache_context(args)
    return (MessageCache(), context) if context else (None, None)


def cache_key(context, args, mailbox=None):
    identity = args.id + "\0" + args.cache_identity
    return CacheKey(context, args.mailbox if mailbox is None else mailbox,
                    identity, MESSAGE_PARSER_VERSION)


def read_message(args):
    cache, context = message_cache(args)
    lookup = cache.get(cache_key(context, args)) if cache else None
    if lookup and lookup.hit and not args.force and cache_context(args) == context:
        return lookup.value
    # A force refresh still captures the current epoch so it cannot race a
    # delete/move/cache clear. Cache failures never prevent reading mail.
    if cache and (lookup is None or args.force):
        lookup = cache.get(cache_key(context, args))
    raw = run_himalaya(args, ["message", "read", "--raw", *mailbox_args(args), "--", args.id])
    try:
        result = parse_message(raw, args.id)
    except (ValueError, RecursionError):
        raise HelperError("Could not parse message from Himalaya") from None
    # Himalaya loads config independently. Do not cache a fetch if the config
    # changed between our identity snapshot and subprocess completion.
    if cache and lookup and cache_context(args) == context:
        cache.put(cache_key(context, args), result, generation=lookup.generation)
    return result


def invalidate_message(args, *mailboxes):
    cache, context = message_cache(args, require_identity=False)
    if cache:
        # Aliases (notably configured/default Inbox) can name the same backend
        # mailbox differently, so invalidate the whole account/config context.
        # If SQLite is locked, leave a marker that makes all future hits fail
        # closed until an explicit cache clear succeeds.
        if not cache.invalidate(context):
            cache.disable()


def list_folders(args):
    raw = run_himalaya(args, ["--json", "mailbox", "list"])
    try:
        mailboxes = json.loads(raw)["mailboxes"]
        if not isinstance(mailboxes, list):
            raise ValueError()
        folders, ids = [], set()
        for mailbox in mailboxes:
            folder = {key: mailbox[key] for key in ("id", "name")}
            if any(not isinstance(value, str) or not value or
                   any(ord(char) < 32 or ord(char) == 127 for char in value)
                   for value in folder.values()) or folder["id"] in ids:
                raise ValueError()
            ids.add(folder["id"])
            # Shared 2.1 output intentionally omits protocol-specific roles.
            # Preserve explicit roles if a future shared API supplies them;
            # conventional-name fallback belongs to the service, not IDs.
            if mailbox.get("role") in ("inbox", "sent", "archive", "trash"):
                folder["role"] = mailbox["role"]
            folders.append(folder)
    except (ValueError, TypeError, KeyError, AttributeError):
        raise HelperError("Invalid mailbox response from Himalaya") from None
    return {"folders": folders}


def list_messages(args):
    raw = run_himalaya(args, ["--json", "envelope", "list", "--page-size", str(PAGE_SIZE),
                              "--page", str(args.page)] + mailbox_args(args))
    try:
        envelopes = json.loads(raw)["envelopes"]
        if not isinstance(envelopes, list):
            raise ValueError()
        messages = []
        # Cross-backend Himalaya output has no durable mailbox generation such
        # as IMAP UIDVALIDITY. Scope cache identities to this authoritative
        # listing so reused IDs can never hit an older persistent entry.
        listing_nonce = uuid.uuid4().hex
        for envelope in envelopes:
            if not isinstance(envelope["id"], str):
                raise ValueError()
            senders = []
            for address in envelope.get("from", []):
                name, email = address.get("name"), address["email"]
                # Display text, not an RFC-5322 address to send. formataddr()
                # rejects internationalized addresses even with an ASCII name.
                senders.append(f"{name} <{email}>" if name else email)
            seen = any(flag.get("iana") == "seen" or
                       flag.get("raw", "").lower().lstrip("\\$") == "seen"
                       for flag in envelope.get("flags", []))
            identity_source = {key: value for key, value in envelope.items() if key != "flags"}
            identity = hashlib.sha256(listing_nonce.encode("ascii") + json.dumps(
                identity_source, ensure_ascii=False, sort_keys=True, separators=(",", ":")
            ).encode("utf-8")).hexdigest()
            messages.append({
                "id": envelope["id"], "subject": envelope.get("subject") or "",
                "from": ", ".join(senders), "date": envelope.get("date") or "",
                "unread": not seen, "cacheIdentity": identity,
            })
    except (ValueError, TypeError, KeyError, AttributeError):
        raise HelperError("Invalid envelope response from Himalaya") from None
    return {"messages": messages, "account": args.account or "Default",
            "page": args.page, "hasNext": len(messages) >= PAGE_SIZE}


def parse_message(raw, message_id):
    message = BytesParser(policy=policy.default).parsebytes(raw)
    part = message.get_body(preferencelist=("html", "plain"))
    body = ""
    links = MessageLinks()
    if part is not None:
        payload = part.get_payload(decode=True)
        if payload is not None:
            try:
                body = payload.decode(part.get_content_charset() or "utf-8", errors="replace")
            except (LookupError, UnicodeError):
                body = payload.decode("utf-8", errors="replace")
        if part.get_content_type() == "text/html":
            parser = HTMLText(links)
            parser.feed(body)
            parser.close()
            body = parser.text()
        else:
            body = links.text(body)
    return {
        "id": message_id,
        **{header: ", ".join(str(value) for value in message.get_all(header, []))
           for header in ("subject", "from", "to", "date")},
        "body": body.strip(), "links": links.links,
        "attachments": attachment_metadata(message),
    }


DEMO_ATTACHMENT = (b'Content-Type: text/plain\nContent-Disposition: attachment; filename="welcome.txt"\n\n'
                   b'Welcome to Jitsmail! This is an offline demo attachment.\n')

DEMO_MESSAGES = [
    {"id": "demo-1", "subject": "Welcome to Jitsmail", "from": "Alex <alex@example.test>",
     "to": "You <you@example.test>", "date": "2026-01-15T10:30:00+00:00", "unread": True,
     "attachments": attachment_metadata(BytesParser(policy=policy.default).parsebytes(DEMO_ATTACHMENT)),
     "body": "Welcome!\n\nThis is demo mail. No account or network was accessed.\n\nTry the link list with o: https://example.com/welcome?source=jitsmail-demo\n\nAlex"},
    {"id": "demo-2", "subject": "Lunch tomorrow?", "from": "Sam <sam@example.test>",
     "to": "You <you@example.test>", "date": "2026-01-14T14:00:00+00:00", "unread": False,
     "body": "Hi,\n\nWould noon work for lunch tomorrow?\n\nSam"},
    {"id": "demo-3", "subject": "A quiet inbox", "from": "Jitsmail <hello@example.test>",
     "to": "You <you@example.test>", "date": "2026-01-13T09:00:00+00:00", "unread": True,
     "body": "Plain text, no remote images, and no tracking requests.\n\nEnjoy your day."},
]


DEMO_MESSAGES.extend({
    "id": f"demo-{number}", "subject": f"Demo message {number}",
    "from": "Jitsmail <hello@example.test>", "to": "You <you@example.test>",
    "date": "2026-01-12T09:00:00+00:00", "unread": number % 3 != 0,
    "body": f"This is demo message {number}. No network was accessed.",
} for number in range(4, 64))


def mark_message(args):
    run_himalaya(args, ["flag", "add" if args.seen else "remove", "--flag", "seen",
                       *mailbox_args(args), "--", args.id])
    return {"id": args.id, "seen": args.seen}


def delete_message(args):
    # Himalaya owns Trash resolution and trash-first policy. Never expunge.
    run_himalaya(args, ["message", "delete", *mailbox_args(args), "--", args.id])
    invalidate_message(args, args.mailbox)
    return {"id": args.id}


def move_message(args):
    source = ["--from=" + args.mailbox] if args.mailbox else []
    run_himalaya(args, ["message", "move", *source, "--to=" + args.destination,
                       "--", args.id])
    invalidate_message(args, args.mailbox, args.destination)
    return {"id": args.id, "destination": args.destination}


DEMO_FOLDERS = [{"id": name, "name": name, "role": name.lower()}
                for name in ("Inbox", "Sent", "Archive", "Trash")]


def demo(args):
    if args.command == "folders":
        return {"folders": DEMO_FOLDERS}
    if args.mailbox and args.mailbox not in {folder["id"] for folder in DEMO_FOLDERS}:
        raise HelperError("Demo folder not found")
    if args.command == "move":
        if args.destination not in {folder["id"] for folder in DEMO_FOLDERS}:
            raise HelperError("Demo destination folder not found")
        if args.destination == (args.mailbox or "Inbox"):
            raise HelperError("Source and destination folders must differ.")
    # Reused IDs intentionally exercise mailbox-scoped service state offline.
    if args.command == "list":
        messages = DEMO_MESSAGES[(args.page - 1) * PAGE_SIZE:args.page * PAGE_SIZE]
        return {"account": args.account or "Demo", "page": args.page,
                "hasNext": len(messages) >= PAGE_SIZE, "messages": [
            {key: message[key] for key in ("id", "subject", "from", "date", "unread")}
            for message in messages
        ]}
    for message in DEMO_MESSAGES:
        if message["id"] == args.id:
            if args.command == "delete":
                return {"id": args.id}
            if args.command == "mark":
                return {"id": args.id, "seen": args.seen}
            if args.command == "move":
                return {"id": args.id, "destination": args.destination}
            links = MessageLinks()
            return {**{key: value for key, value in message.items() if key != "unread"},
                    "body": links.text(message["body"]), "links": links.links,
                    "attachments": message.get("attachments", [])}
    raise HelperError("Demo message not found")


def main(argv=None):
    parser = Parser(description=__doc__)
    parser.add_argument("command", choices=("folders", "list", "read", "mark", "save", "move", "delete", "cache-clear"))
    parser.add_argument("--account", help="Himalaya account name; omit for its default")
    parser.add_argument("--config", help="Himalaya configuration path")
    parser.add_argument("--mailbox", default="", help="backend mailbox ID; omit for the inbox alias")
    parser.add_argument("--id", help="message ID (required for read, mark, save, move, and delete)")
    parser.add_argument("--destination", help="exact backend destination mailbox ID (move only)")
    parser.add_argument("--page", type=int, help="list page, starting at 1")
    parser.add_argument("--attachment", help="content-bound attachment ID (save only)")
    parser.add_argument("--cache-identity", help="SHA-256 identity from the current envelope list (read only)")
    parser.add_argument("--force", action="store_true", help="bypass and replace cache (read only)")
    flags = parser.add_mutually_exclusive_group()
    flags.add_argument("--seen", dest="seen", action="store_true", default=None)
    flags.add_argument("--unseen", dest="seen", action="store_false")
    parser.add_argument("--demo", action="store_true", help="use fixtures; never invoke Himalaya")
    try:
        args = parser.parse_args(argv)
        if args.force and args.command != "read":
            raise HelperError("--force is only supported for read")
        if args.cache_identity is not None and (args.command != "read" or not re.fullmatch(r"[0-9a-f]{64}", args.cache_identity)):
            raise HelperError("--cache-identity requires read and 64 lowercase hexadecimal characters")
        if args.command == "cache-clear":
            if args.demo:
                raise HelperError("cache-clear is not available in demo mode")
            if any(value is not None for value in (args.id, args.destination, args.attachment, args.cache_identity, args.page, args.seen)):
                raise HelperError("cache-clear does not accept message options")
            result = {"cleared": MessageCache().clear()}
            print(json.dumps(result))
            return 0 if result["cleared"] else 1
        if args.command == "delete":
            if not args.account or not args.account.strip():
                raise HelperError("delete requires an explicit --account")
            if not args.id or not args.id.strip():
                raise HelperError("delete requires a nonempty --id")
        if args.command in ("read", "mark", "save", "move", "delete") and not args.id:
            raise HelperError(f"{args.command} requires --id")
        if args.command in ("list", "folders") and args.id is not None:
            raise HelperError("--id is only supported for read, mark, save, move, and delete")
        if args.command == "move":
            if not args.destination or not args.destination.strip():
                raise HelperError("move requires a nonempty --destination")
            if args.mailbox and args.mailbox == args.destination:
                raise HelperError("Source and destination folders must differ.")
        elif args.destination is not None:
            raise HelperError("--destination is only supported for move")
        if args.page is not None and (args.command != "list" or args.page < 1):
            raise HelperError("--page requires list and a positive integer")
        if args.command == "mark":
            if not args.account or not args.account.strip():
                raise HelperError("mark requires an explicit --account")
            if args.seen is None:
                raise HelperError("mark requires --seen or --unseen")
        elif args.seen is not None:
            raise HelperError("--seen and --unseen are only supported for mark")
        if (args.command == "save") != (args.attachment is not None):
            raise HelperError("save requires --attachment; it is not supported for other commands")
        if args.attachment is not None and not re.fullmatch(r"[1-9][0-9]*-[0-9a-f]{64}", args.attachment):
            raise HelperError("Invalid attachment ID")
        args.page = args.page or 1
        if not args.demo and args.command != "folders":
            check_literal_mailbox(args)
        if args.command == "save":
            if args.demo and args.id != "demo-1":
                raise HelperError("Demo attachment not found")
            if args.demo and args.mailbox and args.mailbox not in {folder["id"] for folder in DEMO_FOLDERS}:
                raise HelperError("Demo folder not found")
            raw = DEMO_ATTACHMENT if args.demo else run_himalaya(args, ["message", "read", "--raw", *mailbox_args(args), "--", args.id])
            result = {"id": args.id, **save_attachment(BytesParser(policy=policy.default).parsebytes(raw), args.attachment)}
        elif args.demo:
            result = demo(args)
        elif args.command == "folders":
            result = list_folders(args)
        elif args.command == "list":
            result = list_messages(args)
        elif args.command == "mark":
            result = mark_message(args)
        elif args.command == "move":
            result = move_message(args)
        elif args.command == "delete":
            result = delete_message(args)
        else:
            result = read_message(args)
    except (ValueError, RecursionError):
        print(json.dumps({"error": "Could not parse message attachment"}))
        return 1
    except (HelperError, AttachmentError, MailboxConfigError) as error:
        print(json.dumps({"error": str(error)}))
        return 1
    print(json.dumps(result, ensure_ascii=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
