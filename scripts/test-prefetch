#!/usr/bin/env bash
# Offline production MailService/Process regressions. No production helper runs.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
quickshell=$(command -v quickshell || true)
python=$(command -v python3)
source "$root/tests/integration/harness.sh"
integration_init prefetch
ln -s "$root/MailService.qml" "$work/MailService.qml"
cp "$root/tests/integration/prefetch/python-wrapper" "$work/bin/python3"
cp "$root/tests/integration/prefetch/fixture.py" "$work/fixture.py"
cp "$root/tests/integration/prefetch/shell.qml" "$work/shell.qml"
export YETIMAIL_FIXTURE="$work/fixture.py" YETIMAIL_TEST_PYTHON="$python"

status=0
for scenario in debounce promotion different account config folder page withdrawal pending-withdrawal inactive promoted-stale failure; do
    export YETIMAIL_SCENARIO="$scenario" YETIMAIL_CALLS="$work/$scenario.calls"
    : > "$YETIMAIL_CALLS"
    printf '\n=== prefetch: %s ===\n' "$scenario"
    if ! integration_run_qml "$scenario" 10; then status=1; fi
    if ! integration_assert_output "$scenario" "PREFETCH_OK $scenario" \
        'PREFETCH_FAIL|TypeError|ReferenceError|Unable to assign|Failed to load configuration|FORBIDDEN|Traceback|PRIVATE'; then
        status=1
    fi
    if ! "$python" "$root/tests/integration/prefetch/validate_calls.py" "$YETIMAIL_CALLS" "$scenario"; then
        cat "$YETIMAIL_CALLS"
        status=1
    fi
done
if ! integration_assert_no_himalaya; then status=1; fi
if [[ $status == 0 ]]; then echo YETIMAIL_PREFETCH_OK; fi
exit "$status"
