#!/usr/bin/env bash
# Offline MailService folder navigation/race checks. Never run the real helper.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/tests/integration/harness.sh"
integration_init folders
ln -s "$root" "$work/Yetimail"
cp "$root/tests/integration/folders/python-fixture" "$work/bin/python3"
cp "$root/tests/integration/folders/shell.qml" "$work/shell.qml"
export YETIMAIL_CALLS="$work/calls"
: > "$YETIMAIL_CALLS"

integration_run_qml folders 10
integration_assert_output folders YETIMAIL_FOLDERS_OK \
    'FOLDERS_FAIL|TypeError|ReferenceError|Unable to assign|Failed to load configuration'
cat "$YETIMAIL_CALLS"
grep -q 'mark|offline|localized' "$YETIMAIL_CALLS"
grep -q 'read|offline|opaque' "$YETIMAIL_CALLS"
integration_assert_no_himalaya
