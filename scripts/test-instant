#!/usr/bin/env bash
# Offline regression of the production MailService; never executes the real helper.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
quickshell=$(command -v quickshell || true)
python=$(command -v python3)
source "$root/tests/integration/harness.sh"
integration_init instant
ln -s "$root/MailService.qml" "$work/MailService.qml"
ln -s "$root/AccountSettingsService.qml" "$work/AccountSettingsService.qml"
cp "$root/tests/integration/instant/python-wrapper" "$work/bin/python3"
cp "$root/tests/integration/instant/fixture.py" "$work/fixture.py"
cp "$root/tests/integration/instant/shell.qml" "$work/shell.qml"
export YETIMAIL_FIXTURE="$work/fixture.py" YETIMAIL_TEST_PYTHON="$python"

status=0
for scenario in cold hit switch refresh warm stale config; do
    export YETIMAIL_SCENARIO="$scenario" YETIMAIL_CALLS="$work/$scenario.calls"
    : > "$YETIMAIL_CALLS"
    printf '\n=== instant: %s ===\n' "$scenario"
    if ! integration_run_qml "$scenario" 15; then status=1; fi
    if ! integration_assert_output "$scenario" "INSTANT_OK $scenario" \
        'INSTANT_FAIL|TypeError|ReferenceError|Unable to assign|Failed to load configuration|FORBIDDEN|Traceback'; then
        status=1
    fi
    if ! "$python" "$root/tests/integration/instant/validate_calls.py" "$YETIMAIL_CALLS" "$scenario"; then
        cat "$YETIMAIL_CALLS"
        status=1
    fi
done
if ! integration_assert_no_himalaya; then status=1; fi
if [[ $status == 0 ]]; then echo YETIMAIL_INSTANT_OK; fi
exit "$status"
