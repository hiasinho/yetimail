#!/usr/bin/env bash
# Offline deletion lifecycle. No real Python, Himalaya, config or network in child PATH.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/tests/integration/harness.sh"
integration_init deletions
ln -s "$root" "$work/Yetimail"
cp "$root/tests/integration/deletions/shell.qml" "$work/shell.qml"
cp "$root/tests/integration/deletions/python-fixture" "$work/bin/python3"
export YETIMAIL_CALLS="$work/calls" YETIMAIL_STATE="$work/state"
mkdir "$YETIMAIL_STATE"
: > "$YETIMAIL_CALLS"

integration_run_qml deletions 12
integration_assert_output deletions YETIMAIL_DELETIONS_OK \
    'DELETIONS_FAIL|TypeError|ReferenceError|Unable to assign|Failed to load configuration'
cat "$YETIMAIL_CALLS"
grep -Fq 'delete|offline|Inbox|same|1' "$YETIMAIL_CALLS"
grep -Fq 'delete|second|Exact / Folder|same|1' "$YETIMAIL_CALLS"
if grep -Eq '^(mark|move|save|folders)\|' "$YETIMAIL_CALLS"; then
    echo 'DELETIONS_FAIL: unexpected operation launched' >&2
    exit 1
fi
integration_assert_no_himalaya
