#!/usr/bin/env bash
# Isolated demo shell: never loads the user's mail configuration or installs a plugin.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
omarchy_shell=${OMARCHY_SHELL_PATH:-/usr/share/omarchy/shell}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# Fail closed if a regression accidentally runs Himalaya outside demo mode.
mkdir "$work/bin"
cat > "$work/bin/himalaya" <<'SH'
#!/bin/sh
printf 'Unexpected Himalaya invocation\n' >> "$JITSMAIL_NETWORK_GUARD"
exit 99
SH
chmod +x "$work/bin/himalaya"
export JITSMAIL_NETWORK_GUARD="$work/himalaya-invoked"
export PATH="$work/bin:$PATH"
ln -s "$omarchy_shell/Commons" "$work/Commons"
ln -s "$omarchy_shell/Ui" "$work/Ui"
ln -s "$root" "$work/Jitsmail"
window_type=FloatingWindow
window_properties='implicitWidth: 1000; implicitHeight: 700'
if [[ ${JITSMAIL_INTERACTIVE:-0} == 1 ]]; then
    # A real bar-sized layer surface gives KeyboardPanel correct available
    # height; a tiled FloatingWindow was being mistaken for a giant bar.
    window_type=PanelWindow
    window_properties='implicitWidth: 220; implicitHeight: 32; anchors { top: true; right: true } margins.top: 32; exclusionMode: ExclusionMode.Ignore'
fi
cat > "$work/shell.qml" <<QML
import QtQuick
import Quickshell
import Quickshell.Io
import qs.Commons
import "Jitsmail"
ShellRoot {
    $window_type {
        visible: true
        $window_properties
        color: Color.background
        Text {
            anchors { left: parent.left; verticalCenter: parent.verticalCenter; leftMargin: 8 }
            text: "Jitsmail demo"
            font.family: Style.font.family
            color: Color.foreground
            textFormat: Text.PlainText
        }
        Widget { id: widget; settings: ({demo: true, accounts: "personal,work", account: "personal"}); anchors { top: parent.top; right: parent.right } }
        // The popup needs the anchor window's screen after Wayland maps it.
        Timer { interval: 500; running: true; onTriggered: widget.opened = true }
    }
    // Demo-only IPC makes visual verification repeatable without pointer input.
    IpcHandler {
        target: "jitsmailDemo"
        function open(): void { widget.opened = true }
        function readFirst(): void { widget.opened = true; widget.openCurrent() }
        function help(): void { widget.opened = true; widget.showHelp = !widget.showHelp }
        function attachments(): void { widget.opened = true; widget.toggleAttachments() }
        function folders(): void { widget.opened = true; if (!widget.showFolders) widget.toggleFolders() }
        function close(): void { widget.close() }
    }
    MailService { id: probe; demo: true }
    Timer {
        interval: 100
        running: Quickshell.env("JITSMAIL_INTERACTIVE") !== "1"
        repeat: true
        property bool requested: false
        onTriggered: {
            if (probe.listError || probe.readError) { console.error("SMOKE FAILED: " + probe.listError + probe.readError); Qt.quit() }
            if (!requested && probe.messages.length) { requested = true; probe.readMessage(probe.messages[0].id) }
            if (probe.message) { console.log("JITSMAIL_SMOKE_OK"); Qt.quit() }
        }
    }
    Timer { interval: 10000; running: Quickshell.env("JITSMAIL_INTERACTIVE") !== "1"; onTriggered: { console.error("SMOKE TIMEOUT"); Qt.quit() } }
}
QML
QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-offscreen} quickshell -p "$work" --no-color 2>&1 | tee "$work/output"
if [[ -e "$JITSMAIL_NETWORK_GUARD" ]]; then
    printf 'Demo unexpectedly attempted to invoke Himalaya.\n' >&2
    exit 1
fi
if [[ ${JITSMAIL_INTERACTIVE:-0} == 1 ]]; then exit 0; fi
grep -q 'JITSMAIL_SMOKE_OK' "$work/output"
if grep -Eq 'TypeError|ReferenceError|Unable to assign|Failed to load configuration|SMOKE FAILED|SMOKE TIMEOUT' "$work/output"; then exit 1; fi
