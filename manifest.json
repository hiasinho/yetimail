{
  "schemaVersion": 1,
  "id": "hiasinho.jitsmail",
  "name": "Jitsmail",
  "version": "0.8.0",
  "author": "hiasinho",
  "description": "A keyboard-first Himalaya mail reader with folder navigation and message moves for Omarchy.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Widget.qml" },
  "barWidget": {
    "displayName": "Jitsmail",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "accounts": "", "account": "", "config": "", "demo": false, "refreshSeconds": 120 },
    "schema": [
      { "key": "accounts", "type": "string", "label": "Allowed accounts (comma-separated; empty = single account)" },
      { "key": "account", "type": "string", "label": "Himalaya account (empty = default)" },
      { "key": "config", "type": "string", "label": "Himalaya config path (empty = default)" },
      { "key": "demo", "type": "boolean", "label": "Demo mode (no mail access)" },
      { "key": "refreshSeconds", "type": "integer", "min": 30, "max": 3600, "label": "Refresh interval in seconds (minimum 30)" }
    ]
  }
}
