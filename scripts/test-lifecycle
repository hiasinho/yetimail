#!/usr/bin/env bash
# Offline integration regressions against the real QML and Quickshell Process API.
# python3 is always a shell fixture (or absent); no helper/account is ever opened.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/tests/integration/harness.sh"
integration_init lifecycle
omarchy_shell=${OMARCHY_SHELL_PATH:-/usr/share/omarchy/shell}

ln -s "$omarchy_shell/Commons" "$work/Commons"
# PanelWindow has no offscreen backend. Keep the actual shared Ui types,
# replacing only the compositor popup container (not Widget or MailService).
mkdir "$work/Ui"
for source_file in "$omarchy_shell"/Ui/*; do
    [[ ${source_file##*/} == KeyboardPanel.qml ]] || ln -s "$source_file" "$work/Ui/${source_file##*/}"
done
cp "$root/tests/integration/lifecycle/KeyboardPanel.qml" "$work/Ui/KeyboardPanel.qml"
ln -s "$root" "$work/Yetimail"
cp "$root/tests/integration/lifecycle/python-fixture" "$work/python-fixture"
cp "$root/tests/integration/lifecycle/shell.qml" "$work/shell.qml"

status=0
for scenario in widget accounts race missing unlaunchable; do
    printf '\n=== lifecycle: %s ===\n' "$scenario"
    rm -f "$work/bin/python3"
    case "$scenario" in
        widget|accounts|race) cp "$work/python-fixture" "$work/bin/python3" ;;
        unlaunchable)
            printf '#!/yetimail-test/nonexistent-interpreter\n' > "$work/bin/python3"
            chmod +x "$work/bin/python3" ;;
    esac
    export YETIMAIL_SCENARIO="$scenario" YETIMAIL_CALLS="$work/$scenario.calls"
    : > "$YETIMAIL_CALLS"
    # Restricted PATH also covers missing-python tests: never find real Python.
    if ! integration_run_qml "$scenario" 10; then status=1; fi
    printf '%s\n' '--- fixture calls ---'
    cat "$YETIMAIL_CALLS"
    if ! integration_assert_output "$scenario" "LIFECYCLE_OK $scenario" \
        'LIFECYCLE_FAIL|TypeError|ReferenceError|Unable to assign|Failed to load configuration' ||
       grep -Eq 'FORBIDDEN|BAD ARGUMENT' "$YETIMAIL_CALLS"; then status=1; fi
    case "$scenario" in
        widget)
            if [[ $(wc -l < "$YETIMAIL_CALLS") != 4 ]] ||
               ! grep -qx 'account-labels account=default config=none demo=true id=none' "$YETIMAIL_CALLS" ||
               ! grep -qx 'accounts account=default config=none demo=true id=none' "$YETIMAIL_CALLS" ||
               ! grep -qx 'accounts account=default config=widget-config demo=true id=none' "$YETIMAIL_CALLS" ||
               ! grep -qx 'list account=widget config=widget-config demo=true id=none' "$YETIMAIL_CALLS"; then
                echo 'LIFECYCLE_FAIL widget: unexpected launch count or non-demo invocation'; status=1
            fi ;;
        accounts)
            if [[ $(wc -l < "$YETIMAIL_CALLS") != 6 ]] ||
               grep -Evq '^(account-labels account=default config=none demo=true id=none|accounts account=default config=(none|accounts-config) demo=true id=none|(list|read) account=(personal|work) config=accounts-config demo=true id=)' "$YETIMAIL_CALLS" ||
               ! grep -qx 'list account=personal config=accounts-config demo=true id=none' "$YETIMAIL_CALLS" ||
               ! grep -qx 'read account=personal config=accounts-config demo=true id=personal/accounts-config' "$YETIMAIL_CALLS" ||
               ! grep -qx 'list account=work config=accounts-config demo=true id=none' "$YETIMAIL_CALLS"; then
                echo 'LIFECYCLE_FAIL accounts: unexpected launches or account outside allowlist'; status=1
            fi ;;
        race)
            if [[ $(grep -c '^read ' "$YETIMAIL_CALLS") != 2 ]] || grep -q 'id=duplicate' "$YETIMAIL_CALLS"; then
                echo 'LIFECYCLE_FAIL race: duplicate or missing read launch'; status=1
            fi ;;
        missing|unlaunchable)
            if [[ -s "$YETIMAIL_CALLS" ]]; then echo 'LIFECYCLE_FAIL unexpected executable invocation'; status=1; fi ;;
    esac
done
if ! integration_assert_no_himalaya; then status=1; fi
if [[ $status == 0 ]]; then echo 'YETIMAIL_LIFECYCLE_OK'; fi
exit "$status"
