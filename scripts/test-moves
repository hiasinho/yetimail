#!/usr/bin/env bash
# Offline optimistic move-queue integration checks. Never invokes Himalaya.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/tests/integration/harness.sh"
integration_init moves
mkdir "$work/state"
ln -s "$root" "$work/Yetimail"
cp "$root/tests/integration/moves/python-fixture" "$work/bin/python3"
cp "$root/tests/integration/moves/shell.qml" "$work/shell.qml"
export YETIMAIL_CALLS="$work/calls" YETIMAIL_STATE="$work/state"
: > "$YETIMAIL_CALLS"

integration_run_qml moves 18
integration_assert_output moves YETIMAIL_MOVES_OK \
    'MOVES_FAIL|Concurrent move|TypeError|ReferenceError|Unable to assign|Failed to load configuration'
cat "$YETIMAIL_CALLS"
[ "$(grep -c '^list|offline|' "$YETIMAIL_CALLS")" -eq 2 ]
[ "$(grep -c '^move|offline|' "$YETIMAIL_CALLS")" -eq 3 ]
grep -Fq 'move|failure-offline|Inbox|other|flaky|1' "$YETIMAIL_CALLS"
[ "$(grep -c 'move|failure-offline|Inbox|other|flaky|1' "$YETIMAIL_CALLS")" -eq 2 ]
grep -Fq 'move|failure-offline|Inbox|same|archive|1' "$YETIMAIL_CALLS"
if grep -Fq 'move|cancel-offline|Inbox|other|archive|1' "$YETIMAIL_CALLS" ||
   grep -Fq 'move|stale-offline|Inbox|other|archive|1' "$YETIMAIL_CALLS" ||
   grep -Eq '^(delete|mark|save)\|' "$YETIMAIL_CALLS"; then
    echo 'MOVES_FAIL: rejected or unrelated operation launched' >&2
    exit 1
fi
printf '%s\n' 'move|batch-offline|Inbox|third|archive|1' \
    'move|batch-offline|Inbox|same|archive|1' \
    'move|batch-offline|Inbox|other|trash|1' > "$work/expected-batch"
grep '^move|batch-offline|' "$YETIMAIL_CALLS" > "$work/actual-batch"
diff -u "$work/expected-batch" "$work/actual-batch"
[ "$(grep -c '^list|batch-offline|' "$YETIMAIL_CALLS")" -eq 2 ]
integration_assert_no_himalaya
