#!/usr/bin/env bash
# Offline regressions using the production MailService and Quickshell Process API.
# Real Python runs only with --demo; every other helper request is a shell fixture.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
quickshell=$(command -v quickshell || true)
python=$(command -v python3)
source "$root/tests/integration/harness.sh"
integration_init pagination
export YETIMAIL_TEST_PYTHON="$python"
ln -s "$root/MailService.qml" "$work/MailService.qml"
ln -s "$root/bin/yetimail-helper" "$work/bin/yetimail-helper"
cp "$root/tests/integration/pagination/python-fixture" "$work/bin/python3"
cp "$root/tests/integration/pagination/shell.qml" "$work/shell.qml"

status=0
for scenario in fixture demo; do
    export YETIMAIL_SCENARIO="$scenario" YETIMAIL_CALLS="$work/$scenario.calls"
    : > "$YETIMAIL_CALLS"
    printf '\n=== pagination: %s ===\n' "$scenario"
    if ! integration_run_qml "$scenario" 15; then status=1; fi
    cat "$YETIMAIL_CALLS"
    if ! integration_assert_output "$scenario" "PAGINATION_OK $scenario" \
        'PAGINATION_FAIL|TypeError|ReferenceError|Unable to assign|Failed to load configuration' ||
       grep -Eq 'FORBIDDEN|BAD ' "$YETIMAIL_CALLS"; then status=1; fi
    if [[ $scenario == fixture ]] &&
       ! diff -u "$root/tests/integration/pagination/expected.calls" "$YETIMAIL_CALLS"; then
        status=1
    fi
done
if ! integration_assert_no_himalaya; then status=1; fi
if [[ $status == 0 ]]; then echo YETIMAIL_PAGINATION_OK; fi
exit "$status"
